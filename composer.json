{
    "name": "daika7ana/gls-shipping-api",
    "description": "GLS Shipping & Tracking API",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Dan-Radu Pana",
            "email": "danradu.pana@gmail.com"
        }
    ],
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "econea/nusoap": "^0.9 || ^0.10",
        "guzzlehttp/guzzle": "^7.2 || ^8.0",
        "symfony/dom-crawler": "^6.2 || ^7.0 || ^8.0",
        "symfony/css-selector": "^6.2 || ^7.0 || ^8.0",
        "symfony/validator": "^6.2 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^13"
    },
    "autoload": {
        "psr-4": {
            "GLS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GLS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
